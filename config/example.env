# Copy to .env and fill with your values. NEVER commit .env
# Use read-only API keys whenever possible.

# Exchange (example: Binance)
BINANCE_API_KEY=your_read_only_key_here
BINANCE_SECRET=your_secret_here

# Mode
LIVE_TRADING=false
PAPER_TRADING=true

# Risk limits
MAX_POSITION_PCT=0.02
MAX_DAILY_LOSS_PCT=0.05

# Data
CACHE_DIR=./data/cache
LOG_LEVEL=INFO
